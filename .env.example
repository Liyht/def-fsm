# Copy this file to .env and fill in what you need. Values here take priority
# over configs/paths.yaml; both are read by def_fsm/paths.py.

# Hugging Face cache location and token (needed for gated models).
HF_HOME=
HF_TOKEN=

# Only for data_transformation/fsm_data_generation.py, which reproduces the
# NFSM synthetic baseline through the OpenAI API (Appendix A.1).
OPENAI_API_KEY=

# Any key from configs/paths.yaml may also be set here, e.g.
# SIMULSTREAMING_PATH=/path/to/SimulStreaming
